{
  "name": "camera-controller-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets an AI agent see, inspect and adjust IP cameras and NVR/DVRs (ONVIF, Hikvision, Dahua/Lorex, Axis, Reolink, Uniview) through ONVIF Controller instances, local or remote.",
  "engines": { "node": ">=20" },
  "bin": {
    "camera-controller-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "http": "node index.js --http",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emre-Diricanli/camera-controller-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onvif",
    "ip-camera",
    "nvr",
    "hikvision",
    "dahua",
    "axis",
    "reolink",
    "uniview",
    "ptz"
  ]
}
